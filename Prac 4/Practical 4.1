#include <iostream>
using namespace std;

struct Node
{
    int token;
    Node* next;
};
int main()
{
    Node* head = NULL;
    int choice, token, position;
    while (true)
    {
        cout << "\n1. Insert at Front";
        cout << "\n2. Insert at End";
        cout << "\n3. Insert at Position";
        cout << "\n4. Display Queue";
        cout << "\n5. Exit";
        cout << "\nEnter your choice: ";
        cin >> choice;
        if (choice == 1)
        {
            cout << "Enter patient token: ";
            cin >> token;
            Node* newNode = new Node;
            newNode->token = token;
            newNode->next = head;
            head = newNode;

            cout << "Patient added at front.\n";
        }
        else if (choice == 2)
        {
            cout << "Enter patient token: ";
            cin >> token;
            Node* newNode = new Node;
            newNode->token = token;
            newNode->next = NULL;
            if (head == NULL)
            {
                head = newNode;
            }
            else
            {
                Node* temp = head;
                while (temp->next != NULL)
                {
                    temp = temp->next;
                }
                temp->next = newNode;
            }

            cout << "Patient added at end.\n";
        }
        else if (choice == 3)
        {
            cout << "Enter patient token: ";
            cin >> token;

            cout << "Enter position: ";
            cin >> position;

            if (position < 1)
            {
                cout << "Invalid position.\n";
            }
            else if (position == 1)
            {
                Node* newNode = new Node;
                newNode->token = token;
                newNode->next = head;
                head = newNode;
                cout << "Patient added.\n";
            }
            else
            {
                Node* temp = head;
                int i = 1;

                while (temp != NULL && i < position - 1)
                {
                    temp = temp->next;
                    i++;
                }
                if (temp == NULL)
                {
                    cout << "Position is greater than current length.\n";
                }
                else
                {
                    Node* newNode = new Node;
                    newNode->token = token;

                    newNode->next = temp->next;
                    temp->next = newNode;

                    cout << "Patient added at position " << position << ".\n";
                }
            }
        }
        else if (choice == 4)
        {
            if (head == NULL)
            {
                cout << "Queue is empty.\n";
            }
            else
            {
                Node* temp = head;
                cout << "\nPatient Queue: ";
                while (temp != NULL)
                {
                    cout << temp->token << " ";
                    temp = temp->next;
                }
                cout << endl;
            }
        }
        else if (choice == 5)
        {
            break;
        }
        else
        {
            cout << "Invalid choice.\n";
        }
    }
    return 0;
}